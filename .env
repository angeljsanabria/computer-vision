# Captura
CONFIG_MODO=RTSP
MAX_FPS=3
DISPLAY_IS_ENABLE=false

# Camara IP
IP_CAM=192.168.0.160
IP_CAM_USER=angelcam
IP_CAM_PASS=angelCamara

# Camara USB
USB_DEVICE_INDEX=0
USB_CAMERA_IMAGE_MODE=USE_DEFAULT

# Plataforma y retencion de identidad
INFERENCE_BACKEND=rk3568
FSM_RECOGNIZED_REFRESH_S=15

# Log
LOG_MODE=prod

# API HTTP
ENABLE_ENDPOINT=true
HTTP_API_PORT=8008

# Guardar captura para ver calidad de imagen
IMG_QUALITY_CHECK_ENABLE=false
