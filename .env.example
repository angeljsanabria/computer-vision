# Captura
CONFIG_MODO=RTSP     # RTSP, SNAP, USB
MAX_FPS=3
DISPLAY_IS_ENABLE=false # en modo headless siempre es false

# Camara IP
IP_CAM=192.168.0.160    # IP asignada en la red local
IP_CAM_USER=angelcam    # User y pass de la camara
IP_CAM_PASS=angelCamara

# Camara USB
USB_DEVICE_INDEX=0
USB_CAMERA_IMAGE_MODE=USE_DEFAULT

# Plataforma y retencion de identidad
INFERENCE_BACKEND=rk3568 # rk3568, pc
FSM_RECOGNIZED_REFRESH_S=15 # segundos que se mantiene un MATCH en FACE_RECOGNIZED antes de volver a procesar cara

# Nozzle Bidon/Pico (YOLOv8n nozzle_bidones)
ENABLE_NOZZLE=true
NOZZLE_MODEL_PC=models_onnx/yolov8n_nozzle_bidones_v12.onnx
NOZZLE_MODEL_RK3568=models/yolov8n_nozzle_bidones_v12.rknn
NOZZLE_INPUT_SIZE=0

# Log
LOG_MODE=prod # prod, dev tiene mas logs de debug

# API HTTP
ENABLE_ENDPOINT=true # true, false
HTTP_API_PORT=8008 # puerto del endpoint

# Check Calidad de imagen
IMG_QUALITY_CHECK_ENABLE=false # true, false guarda cada 30 segundos en /data
